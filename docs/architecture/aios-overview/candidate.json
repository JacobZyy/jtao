  "cards": [
    {
      "dot": "cyan",
      "title": "工作流决策",
      "items": [
        "AIOS 决定本轮采用直接、受控或计划路径。Rex 生成当前能力命令并校验证据推进。",
        "计划按工单创建或复用。受控路径也可以绑定能力激活。"
      ]
    },
    {
      "dot": "emerald",
      "title": "执行与恢复",
      "items": [
        "Team 调度子任务和客户端。Solo 保存轮次、检查点与连续性记录，用于恢复运行。",
        "需要隔离的 Team 任务可受 Rex 绑定门约束。Solo 轮次可回写活动计划。"
      ]
    },
    {
      "dot": "violet",
      "title": "项目数据",
      "items": [
        "计划在 docs/plans 与 .aios/planning。Rex 激活与回执在 .rex-harness。",
        "ContextDB 保存会话与运行记录，Memo 保存可召回的项目知识。"
      ]
    },
    {
      "dot": "amber",
      "title": "模型接入",
      "items": [
        "客户端接入后访问本机网关。网关按目标或规则选择上游，并记录路由决策。",
        "控制台管理网关和客户端接入，也读取工作区状态及资源清单。"
      ]
    }
  ]
